{
  "name": "zayvi-db-bootstrap",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --outfile=dist/index.js",
    "fetch:ca": "test -s global-bundle.pem || curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o global-bundle.pem",
    "package": "npm run fetch:ca && npm run build && node ../scripts/package-lambda.cjs db-bootstrap"
  }
}
