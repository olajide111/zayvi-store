{
  "name": "zayvi-api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1179.0",
    "@aws-sdk/rds-signer": "^3.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild handler.js --bundle --platform=node --target=node22 --outfile=dist/index.js",
    "package": "npm run fetch:ca && npm run build && node ../scripts/package-lambda.cjs api",
    "fetch:ca": "test -s global-bundle.pem || curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o global-bundle.pem",
    "build:merchant-registration": "esbuild merchant-registration.js --bundle --platform=node --target=node22 --outfile=dist/merchant-registration.js",
    "package:merchant-registration": "npm run fetch:ca && npm run build:merchant-registration && node ../scripts/package-lambda.cjs merchant-registration"
  }
}
