{
  "name": "zayvi-api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "^3.0.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --outfile=dist/index.js",
    "package": "npm run fetch:ca && npm run build && rm -f ../terraform/zayvi-api-bootstrap.zip && zip -j ../terraform/zayvi-api-bootstrap.zip dist/index.js global-bundle.pem",
    "fetch:ca": "test -s global-bundle.pem || curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o global-bundle.pem"
  }
}
